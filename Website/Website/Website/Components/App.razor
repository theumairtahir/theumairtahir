<!DOCTYPE html>
<html lang="en" class="sl:h-full sl:antialiased">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />

    @* Apply the stored theme before first paint so the page never flashes the wrong scheme. *@
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('tailwindui-blazor-theme');
                var dark = stored === 'dark' ||
                    (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.classList.toggle('dark', dark);
            } catch (_) { /* ignore */ }
        })();
    </script>

    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="stylesheet" href="@Assets["css/tailwindui.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["Website.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body class="font-sans sl:flex sl:min-h-full sl:bg-zinc-50 sl:dark:bg-black">
    <Routes />
    <script src="@Assets["js/site.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
