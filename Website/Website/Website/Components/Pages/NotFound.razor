@page "/not-found"
@layout MainLayout

<PageTitle>Not found - @SiteContent.Name</PageTitle>

<PageContainer Class="sl:flex sl:h-full sl:items-center sl:pt-16 sl:sm:pt-32">
    <div class="sl:flex sl:flex-col sl:items-center">
        <p class="sl:text-base sl:font-semibold sl:text-zinc-400 sl:dark:text-zinc-500">404</p>
        <h1 class="sl:mt-4 sl:text-4xl sl:font-bold sl:tracking-tight sl:text-zinc-800 sl:sm:text-5xl sl:dark:text-zinc-100">Page not found</h1>
        <p class="sl:mt-4 sl:text-base sl:text-zinc-600 sl:dark:text-zinc-400">
            Sorry, the page you’re looking for doesn’t exist.
        </p>
        <Button Href="/" Variant="ButtonVariant.Secondary" Text="Go back home" class="sl:mt-4" />
    </div>
</PageContainer>
