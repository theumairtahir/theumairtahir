@inject NavigationManager Navigation

<header class="sl:pointer-events-none sl:sticky sl:top-0 sl:z-50 sl:flex-none sl:pt-6">
    <PageContainer>
        <div class="sl:relative sl:flex sl:gap-4">
            <div class="sl:flex sl:flex-1">
                <a href="/" aria-label="Home"
                   class="sl:pointer-events-auto sl:block sl:rounded-full sl:shadow-lg sl:ring-1 sl:shadow-zinc-800/5 sl:ring-zinc-900/5 sl:dark:ring-white/10">
                    <Avatar Initials="@SiteContent.Name" InitialsBackground="ThemeColor.Primary" />
                </a>
            </div>

            <div class="sl:flex sl:flex-1 sl:justify-end sl:md:justify-center">
                @* Mobile: a native popover, so the menu opens without any Blazor interactivity. *@
                <div class="sl:pointer-events-auto sl:md:hidden">
                    <button type="button" popovertarget="mobile-nav"
                            class="sl:group sl:flex sl:items-center sl:rounded-full sl:bg-white/90 sl:px-4 sl:py-2 sl:text-sm sl:font-medium sl:text-zinc-800 sl:shadow-lg sl:ring-1 sl:shadow-zinc-800/5 sl:ring-zinc-900/5 sl:backdrop-blur-sm sl:dark:bg-zinc-800/90 sl:dark:text-zinc-200 sl:dark:ring-white/10 sl:dark:hover:ring-white/20">
                        Menu
                        <Icon Name="chevron-down" Variant="IconVariant.Micro" Size="size-4" class="sl:ml-2 sl:text-zinc-500 sl:group-hover:text-zinc-700 sl:dark:group-hover:text-zinc-400" />
                    </button>

                    <div id="mobile-nav" popover
                         class="sl:pointer-events-auto sl:fixed sl:inset-x-4 sl:top-8 sl:bottom-auto sl:m-0 sl:w-auto sl:rounded-3xl sl:border-0 sl:bg-white sl:p-8 sl:text-zinc-800 sl:ring-1 sl:ring-zinc-900/5 sl:backdrop:bg-zinc-800/40 sl:backdrop:backdrop-blur-xs sl:dark:bg-zinc-900 sl:dark:text-zinc-300 sl:dark:ring-zinc-800 sl:dark:backdrop:bg-black/80">
                        <div class="sl:flex sl:flex-row-reverse sl:items-center sl:justify-between">
                            <button type="button" popovertarget="mobile-nav" popovertargetaction="hide" aria-label="Close menu" class="sl:-m-1 sl:p-1">
                                <Icon Name="x-mark" class="sl:text-zinc-500 sl:dark:text-zinc-400" />
                            </button>
                            <h2 class="sl:text-sm sl:font-medium sl:text-zinc-600 sl:dark:text-zinc-400">Navigation</h2>
                        </div>
                        <nav class="sl:mt-6">
                            <ul class="sl:-my-2 sl:divide-y sl:divide-zinc-100 sl:text-base sl:dark:divide-zinc-100/5">
                                @foreach (var link in SiteNav.Links)
                                {
                                    <li><a href="@link.Href" class="sl:block sl:py-2">@link.Label</a></li>
                                }
                            </ul>
                        </nav>
                    </div>
                </div>

                <nav class="sl:pointer-events-auto sl:hidden sl:md:block">
                    <ul class="sl:flex sl:rounded-full sl:bg-white/90 sl:px-3 sl:text-sm sl:font-medium sl:text-zinc-800 sl:shadow-lg sl:ring-1 sl:shadow-zinc-800/5 sl:ring-zinc-900/5 sl:backdrop-blur-sm sl:dark:bg-zinc-800/90 sl:dark:text-zinc-200 sl:dark:ring-white/10">
                        @foreach (var link in SiteNav.Links)
                        {
                            var active = IsActive(link.Href);
                            <li>
                                <a href="@link.Href" aria-current="@(active ? "page" : null)"
                                   class="sl:relative sl:block sl:px-3 sl:py-2 sl:transition @(active ? "sl:text-teal-500 sl:dark:text-teal-400" : "sl:hover:text-teal-500 sl:dark:hover:text-teal-400")">
                                    @link.Label
                                    @if (active)
                                    {
                                        <span class="sl:absolute sl:inset-x-1 sl:-bottom-px sl:h-px sl:bg-linear-to-r sl:from-teal-500/0 sl:via-teal-500/40 sl:to-teal-500/0 sl:dark:from-teal-400/0 sl:dark:via-teal-400/40 sl:dark:to-teal-400/0"></span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>

            <div class="sl:flex sl:justify-end sl:md:flex-1">
                <button type="button" data-theme-toggle aria-label="Toggle theme"
                        class="sl:group sl:pointer-events-auto sl:rounded-full sl:bg-white/90 sl:px-3 sl:py-2 sl:shadow-lg sl:ring-1 sl:shadow-zinc-800/5 sl:ring-zinc-900/5 sl:backdrop-blur-sm sl:transition sl:dark:bg-zinc-800/90 sl:dark:ring-white/10 sl:dark:hover:ring-white/20">
                    <Icon Name="sun" class="sl:text-zinc-500 sl:transition sl:group-hover:text-zinc-700 sl:dark:hidden" />
                    <Icon Name="moon" class="sl:hidden sl:text-teal-400 sl:transition sl:group-hover:text-teal-300 sl:dark:block" />
                </button>
            </div>
        </div>
    </PageContainer>
</header>

@code {
    private bool IsActive(string href)
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        return path.Equals(href, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
    }
}
